---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { formatPostDate } from '../lib/date';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<section>
  <h2 class="text-sm font-medium text-flexoki-base-8 dark:text-flexoki-base-7 uppercase tracking-wider mb-4">
    More posts
  </h2>
  <ul class="space-y-4">
    {posts.map((post) => (
      <li>
        <a href={`/posts/${post.slug}`} class="group block">
          <span class="font-medium group-hover:text-flexoki-base-8 dark:group-hover:text-flexoki-base-7 transition-colors">
            {post.data.title}
          </span>
          <time
            datetime={post.data.date.toISOString()}
            class="block text-sm text-flexoki-base-8 dark:text-flexoki-base-7 mt-0.5"
          >
            {formatPostDate(post.data.date)}
          </time>
        </a>
        {post.data.tags && post.data.tags.length > 0 && (
          <TagList tags={post.data.tags} class="mt-1.5" />
        )}
      </li>
    ))}
  </ul>
</section>
