---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/posts', label: 'Posts' },
];

const currentPath = Astro.url.pathname;
---

<header class="max-w-2xl mx-auto w-full px-4 py-5 flex items-center justify-between">
  <div class="flex items-center gap-6">
    <a
      href="/"
      class={`text-sm font-medium transition-colors ${
        currentPath === '/'
          ? 'text-flexoki-black dark:text-flexoki-base-5'
          : 'text-flexoki-base-8 dark:text-flexoki-base-7 hover:text-flexoki-black dark:hover:text-flexoki-base-5'
      }`}
    >
      Alperen Albayrak
    </a>
    <nav class="flex gap-5 text-sm">
      {nav.map(({ href, label }) => (
        <a
          href={href}
          class={`transition-colors ${
            currentPath === href || currentPath.startsWith(href)
              ? 'text-flexoki-black dark:text-flexoki-base-5 font-medium'
              : 'text-flexoki-base-8 dark:text-flexoki-base-7 hover:text-flexoki-black dark:hover:text-flexoki-base-5'
          }`}
        >
          {label}
        </a>
      ))}
      <a
        href="/rss.xml"
        class="text-flexoki-base-8 dark:text-flexoki-base-7 hover:text-flexoki-black dark:hover:text-flexoki-base-5 transition-colors"
        title="RSS Feed"
      >
        RSS
      </a>
    </nav>
  </div>
  <ThemeToggle />
</header>
